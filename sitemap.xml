---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="/pdf/sitemap.xsl"?>

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

<!-- Homepage -->
<url>
  <loc>{{ site.url }}{{ site.baseurl }}/</loc>
  <priority>1.0</priority>
</url>

<!-- Pages -->
{% for page in site.pages %}

{% unless page.url contains '.xml' %}
{% unless page.url contains '404' %}
{% unless page.url contains '/assets/' %}
{% unless page.url contains '.css' %}
{% unless page.url contains '.js' %}
{% unless page.url contains '.json' %}
{% unless page.url contains '.txt' %}
{% unless page.url contains '.png' %}
{% unless page.url contains '.jpg' %}
{% unless page.url contains '.jpeg' %}
{% unless page.url contains '.webp' %}
{% unless page.url contains '.svg' %}
{% unless page.sitemap == false %}

<url>
  <loc>{{ site.url }}{{ site.baseurl }}{{ page.url }}</loc>
  <priority>0.8</priority>
</url>

{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}
{% endunless %}

{% endfor %}

<!-- Posts -->
{% for post in site.posts %}

<url>
  <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
  <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  <priority>0.9</priority>
</url>

{% endfor %}

</urlset>
